# RadSim Configuration
# Copy this to ~/.radsim/.env and fill in your API keys.
#
# Provider/model selection and credentials are read from ~/.radsim/.env (and a
# preferred env file set via RADSIM_ENV_FILE). Project-local .env files in the
# working directory are IGNORED for provider config by default, so an untrusted
# repository cannot redirect the provider or inject credentials. To opt a
# trusted project back in, set RADSIM_TRUST_PROJECT_ENV=1.

# =============================================================================
# PROVIDER SELECTION
# =============================================================================
# Current CLI options: openrouter, openai, claude
RADSIM_PROVIDER="openrouter"

# =============================================================================
# MODEL SELECTION
# =============================================================================

# Default OpenRouter model
RADSIM_MODEL="moonshotai/kimi-k2.5"

# OpenRouter models listed in main:
#   - moonshotai/kimi-k2.5
#   - anthropic/claude-opus-4.6
#   - anthropic/claude-sonnet-4.6
#   - openai/gpt-5.4
#   - openai/gpt-5.3-codex
#   - openai/gpt-5.2-codex
#   - minimax/minimax-m2.1
#   - z-ai/glm-4.7

# OpenAI models listed in main:
#   - gpt-5.4
#   - gpt-5.3-codex
#   - gpt-5.2
#   - gpt-5.2-codex
#   - gpt-5-mini

# Claude models listed in main:
#   - claude-opus-4-6
#   - claude-sonnet-4-5
#   - claude-haiku-4-5

# =============================================================================
# API KEYS
# =============================================================================
# Add only the keys you use.

# OpenRouter - https://openrouter.ai/keys
OPENROUTER_API_KEY="your-openrouter-key-here"

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-key-here"

# Claude (Anthropic) - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="your-anthropic-key-here"

# =============================================================================
# TELEGRAM (Optional)
# =============================================================================

TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# =============================================================================
# SECURITY (Optional)
# =============================================================================

# Access code protection. Leave empty to disable.
# RADSIM_ACCESS_CODE="your-access-code"

# =============================================================================
# PERFORMANCE TELEMETRY (Optional)
# =============================================================================
# Writes privacy-safe timing, count, token, and outcome events to:
# ~/.radsim/logs/performance.jsonl
# Prompt text, user messages, tool arguments, tool results, and error messages
# are never included. The file rotates at 10 MB with three backups.
# RADSIM_PERFORMANCE_TELEMETRY="1"

# =============================================================================
# TOOL-SCHEMA ROUTING (Optional, experimental)
# =============================================================================
# Sends a core tool set plus the capability groups a turn indicates instead of
# all schemas, cutting fixed request tokens. Permission tiers and confirmation
# prompts are unchanged, and an omitted tool is still executable: its group is
# restored for the rest of the turn.
# RADSIM_TOOL_SCHEMA_ROUTING="1"
# Maximum estimated tokens for routed schemas. Default 4000, minimum 1000.
# RADSIM_TOOL_SCHEMA_BUDGET_TOKENS="4000"

# =============================================================================
# PROMPT CACHING
# =============================================================================
# On by default for Anthropic Claude models (direct or via OpenRouter). Marks
# the tool schemas and static policy as a cacheable prefix so repeated requests
# in a turn are billed at cache-read rates. Prompt text is unchanged.
# Set to "0" to send every request uncached.
# RADSIM_PROMPT_CACHING="0"

# =============================================================================
# SECRET EXPIRATION MONITORING (Optional)
# =============================================================================
# Track when your API keys expire to get warnings before they do.
# Format: RADSIM_SECRET_EXPIRY_<NAME>=YYYY-MM-DD
#
# Examples:
# RADSIM_SECRET_EXPIRY_OPENROUTER="2026-12-31"
# RADSIM_SECRET_EXPIRY_OPENAI="2026-12-31"
# RADSIM_SECRET_EXPIRY_ANTHROPIC="2026-12-31"
